{
  "name": "gestiones-comerciales",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "22.14.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @gc/web dev",
    "dev:backoffice": "pnpm --filter @gc/backoffice dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @gc/web build",
    "build:backoffice": "pnpm --filter @gc/backoffice build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint apps/web/src apps/backoffice/src apps/mobile/src --max-warnings 9999",
    "ops:preflight": "node --experimental-strip-types scripts/ops/preflight.ts",
    "ops:golive": "node --experimental-strip-types scripts/ops/golive-preflight.ts",
    "test:contracts": "node --experimental-strip-types --test tests/*.test.ts scripts/ci/*.test.ts scripts/ops/*.test.ts"
  },
  "pnpm": {
    "overrides": {
      "tar@<7.5.19": "7.5.22",
      "postcss@<8.5.26": "8.5.26"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "typescript-eslint": "^8.69.0"
  }
}
