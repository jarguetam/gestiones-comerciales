# apps/mobile — variables públicas de Expo (anon key, nunca service_role)
# Emulador Android: 10.0.2.2 apunta al PC. En teléfono físico usa la IPv4 LAN del PC.
EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
# Copiar la anon/publishable key de Supabase LOCAL; nunca una clave de producción.
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-o-publishable-key
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ENVIRONMENT=local
