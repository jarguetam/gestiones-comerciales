# Público. Nunca service_role.
# Placeholders NO activan el cliente (credencialesPublicasValidas).
# Build exige URL + anon + VITE_SENTRY_DSN + VITE_RELEASE (requireBuildEnv).
# CI de Pages exige valores reales en el Environment `production`.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui
VITE_SENTRY_DSN=https://public@o0.ingest.sentry.io/0
VITE_RELEASE=local
VITE_ENVIRONMENT=local

# Backoffice — mismas credenciales públicas del entorno
VITE_BACKOFFICE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_BACKOFFICE_ANON_KEY=tu_anon_key_aqui
