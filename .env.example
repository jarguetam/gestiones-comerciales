# Supabase — proyecto: GestionesComercialesApp (ref: xcoeipsnykceorcvjwve)
# La anon key es pública por diseño (va al cliente). NUNCA pongas service_role aquí.
#
# Sin URL+anon reales (o con los placeholders de abajo) las apps entran en DEMO_MODE:
# el login abre el tablero con datos de demostración.
# Con URL+JWT anon reales el cliente habla con el backend; el botón
# «Entrar al tablero» sigue disponible si no tenés usuario confirmado.
#
# GitHub Pages (job deploy en .github/workflows/ci.yml) inyecta
# VITE_SUPABASE_URL y VITE_SUPABASE_ANON_KEY desde secrets del repo.
# Si esos secrets faltan, Pages queda en DEMO. Cargalos en
# Settings → Secrets and variables → Actions.

VITE_SUPABASE_URL=https://xcoeipsnykceorcvjwve.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Backoffice (app de plataforma) — mismas credenciales públicas
VITE_BACKOFFICE_URL=https://xcoeipsnykceorcvjwve.supabase.co
VITE_BACKOFFICE_ANON_KEY=tu_anon_key_aqui
